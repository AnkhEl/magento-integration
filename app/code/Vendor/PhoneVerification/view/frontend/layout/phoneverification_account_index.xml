<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <update handle="customer_account"/>
    <head>
        <title>Phone &amp; WhatsApp</title>
        <css src="Vendor_PhoneVerification::css/phone-verification.css"/>
    </head>
    <body>
        <referenceContainer name="content">
            <!-- cacheable="false": the page shows this customer's number and code, so full-page cache must never store it -->
            <block class="Magento\Framework\View\Element\Template"
                   name="phoneverification.account"
                   template="Vendor_PhoneVerification::account/phone.phtml"
                   cacheable="false">
                <arguments>
                    <argument name="view_model" xsi:type="object">Vendor\PhoneVerification\ViewModel\PhoneAccount</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
